{
  "name": "ghcarpool",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:frontend": "pnpm --filter @ghcarpool/frontend dev",
    "dev:backend": "pnpm --filter @ghcarpool/backend dev",
    "build": "pnpm --filter @ghcarpool/frontend build && pnpm --filter @ghcarpool/backend build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@firebase/util", "esbuild", "msw", "protobufjs", "re2"]
  }
}
