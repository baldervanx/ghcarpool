# ============================================================
# Kopieras till .env i rotkatalogen och fylls i.
# Används av docker-compose.yml.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=ghcarpool
POSTGRES_PASSWORD=byt_ut_mig
POSTGRES_DB=ghcarpool

# ── Express session ──────────────────────────────────────────
# Minst 32 tecken, slumpmässig sträng — generera med:
#   openssl rand -hex 32
SESSION_SECRET=byt_ut_mig_minst_32_tecken_lång_sträng

# ── Firebase (frontend — byggs in i JS-bundeln vid docker build) ───────────
# Hitta värdena i Firebase Console → Projektinställningar → Dina appar
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=ditt-projekt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ditt-projekt
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ── Firebase Admin SDK (backend) ────────────────────────────
# Alt 1 — hela service-account JSON på en rad (rekommenderas för Docker/CI):
#   Hämta från Firebase Console → Projektinst. → Tjänstekonton → Generera ny nyckel
#   Klistra in hela JSON-filen som ett enda värde (inga radbrytningar):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
#
# Alt 2 — montera filen och peka ut sökvägen (kräver volumes-konfiguration i compose):
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-sa.json

# ── App ─────────────────────────────────────────────────────
# URL som backend tillåter CORS-anrop från
FRONTEND_URL=http://localhost
# Porten som nginx lyssnar på på värddatorn
APP_PORT=80
