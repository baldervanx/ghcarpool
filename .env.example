# Copy to .env for docker-compose.yml. Do not commit real secrets.
POSTGRES_USER=ghcarpool
# Use a strong URL-safe password (for example: openssl rand -hex 32).
# DATABASE_URL is composed from these values; reserved URL characters need encoding.
POSTGRES_PASSWORD=replace_with_random_hex
POSTGRES_DB=ghcarpool
SESSION_SECRET=replace_with_at_least_32_random_characters

# Local HTTP smoke test. App listens on 3001 inside the container.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3001
FRONTEND_URL=http://localhost:3001
TRUST_PROXY=false
COOKIE_SECURE=false

# Normal restarts never change the database schema.
# Explicit deploy: docker compose run --rm --no-deps app ./node_modules/.bin/prisma migrate deploy
# Set true only to opt into migrations before every app startup (errors stop startup).
RUN_MIGRATIONS=false

# HTTPS behind a trusted external reverse proxy: replace FRONTEND_URL with
# the public HTTPS origin, set COOKIE_SECURE=true, and set TRUST_PROXY to
# the actual proxy IP/CIDR (comma-separated lists supported).
# TRUST_PROXY=1 is only safe when EVERY request traverses exactly one trusted
# proxy and the app port cannot be reached by untrusted clients.
# APP_BIND_ADDRESS stays loopback for a proxy on the host. Container proxies
# should use a private shared network and reach app:3001 (see README).

# Existing optional Google OAuth configuration.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
VITE_GOOGLE_AUTH_ENABLED=false
