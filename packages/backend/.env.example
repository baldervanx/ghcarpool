# Kopieras till .env och fylls i

# PostgreSQL
DATABASE_URL=postgresql://ghcarpool:dev@127.0.0.1:5432/ghcarpool_dev

# Express session — godtagbar för lokal dev, byt i produktion
SESSION_SECRET=dev-secret-minst-32-tecken-byt-i-prod

# Google OAuth (valfritt — lämna tomt för att inaktivera)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# App
FRONTEND_URL=http://localhost:5173
PORT=3001
NODE_ENV=development
