# ============================================================
# Kopieras till .env i rotkatalogen och fylls i.
# Används av docker-compose.yml.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=ghcarpool
POSTGRES_PASSWORD=byt_ut_detta
POSTGRES_DB=ghcarpool

# Exponera PostgreSQL-port mot värddatorn (för DB-verktyg som TablePlus/pgAdmin).
# Utelämna eller lämna tom för att stänga ned DB-porten i produktion.
#POSTGRES_EXPOSE_PORT=5432

# ── Express session ──────────────────────────────────────────
# Minst 32 tecken — generera med: openssl rand -hex 32
SESSION_SECRET=byt_ut_detta_till_en_lång_slumpmässig_sträng

# ── Google OAuth (optionellt) ─────────────────────────────────
# Lämna tomt för att inaktivera Google-inloggning.
#GOOGLE_CLIENT_ID=ditt-client-id.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=ditt-client-secret
#VITE_GOOGLE_AUTH_ENABLED=true

# ── App ─────────────────────────────────────────────────────
# HTTP-port (standard: 80)
APP_PORT=80
# Frontend-URL för CORS och OAuth-redirectar
FRONTEND_URL=http://localhost

# ── HTTPS (optionellt) ───────────────────────────────────────
# Kräver SSL-certifikat. Steg:
#   1. Lägg cert.pem + key.pem i en katalog, t.ex. ./certs/
#      Självsignerat för lokal testning:
#        mkdir -p certs
#        openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#          -keyout certs/key.pem -out certs/cert.pem -subj "/CN=localhost"
#   2. Avkommentera raderna nedan:
#HTTPS_PORT=443
#CERTS_DIR=./certs
#COOKIE_SECURE=true
#FRONTEND_URL=https://din-domän.se
