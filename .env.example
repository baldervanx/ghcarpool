# ============================================================
# Kopieras till .env i rotkatalogen och fylls i.
# Används av docker-compose.yml.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=ghcarpool
POSTGRES_PASSWORD=byt_ut_detta
POSTGRES_DB=ghcarpool

# ── Express session ──────────────────────────────────────────
# Minst 32 tecken, slumpmässig sträng — generera med:
#   openssl rand -hex 32
SESSION_SECRET=byt_ut_detta_till_en_lång_slumpmässig_sträng

# ── Google OAuth (optionellt) ─────────────────────────────────
# Lämna tomt för att inaktivera Google-inloggning.
# Skapa OAuth-klienten i Google Cloud Console → APIs & Services → Credentials.
# Auktoriserade redirect-URIer: http://<din-domän>/api/v1/auth/google/callback
#GOOGLE_CLIENT_ID=ditt-client-id.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=ditt-client-secret

# Om Google OAuth är aktiverat, exponera det för frontend-bundeln:
#VITE_GOOGLE_AUTH_ENABLED=true

# ── App ─────────────────────────────────────────────────────
# URL som backend tillåter CORS-anrop från
FRONTEND_URL=http://localhost
# Porten som nginx lyssnar på på värddatorn
APP_PORT=80
