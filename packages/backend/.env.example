# Kopieras till .env och fylls i

# PostgreSQL
DATABASE_URL="postgresql://ghcarpool:CHANGE_ME@127.0.0.1:5432/ghcarpool_dev"

# Express session
SESSION_SECRET="CHANGE_ME_min_32_chars_random_string"

# Firebase Admin SDK (välj ett av alternativen nedan)
# Alt 1: sökväg till service-account-fil
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/serviceAccount.json"
# Alt 2: hela JSON-strängen som env-var (CI/CD)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Google OAuth (används av passport-google-oauth20)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# App
FRONTEND_URL="http://localhost:5173"
PORT=3000
NODE_ENV=development
