generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id          // Signaturen anges explicit, t.ex. "AS"
  name             String   @default("") // Fullständigt namn, t.ex. "Anders Svensson"
  email            String   @unique
  isAdmin          Boolean  @default(false)
  shortName        String   @default("")
  commentMandatory Boolean  @default(false)
  passwordHash     String?
  createdAt        DateTime @default(now())

  bookingsMade  Booking[]       @relation("BookingByUser")
  bookingUsers  BookingUser[]
  tripsMade     Trip[]          @relation("TripByUser")
  tripUsers     TripUser[]

  errorLogsAssigned  ErrorLog[]       @relation("ErrorLogAssignee")
  errorLogsUpdated   ErrorLog[]       @relation("ErrorLogUpdater")
  errorLogComments   ErrorLogComment[] @relation("ErrorLogCommentAuthor")
  expenses           Expense[]        @relation("ExpenseByUser")
}

// Sessions hanteras av connect-pg-simple, skapar tabellen via migration nedan
model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@index([expire])
  @@map("session")
}

model Car {
  id      String  @id          // Reg-numret anges explicit, t.ex. "ABC123"
  name    String               // Smeknamn, t.ex. "Volvon"
  range   Int     @default(0)
  order   Int     @default(0)
  hasLog  Boolean @default(true)

  dateCarBookings DateCarBooking[]
  trips           Trip[]
  errorLogs       ErrorLog[]
  expenses        Expense[]
  carInfo         CarInfo?
}

model Destination {
  id        String  @id @default(cuid())
  name      String
  shortName String  @default("")
  distance  Int?
  temporary Boolean @default(false)  // true = skapad automatiskt, ej granskad av admin

  bookings Booking[]
}

model Settings {
  id         String  @id @default("main")
  costPerKm  Float   @default(1.0)
  extra      Json?
}

model DateCarBooking {
  id        String   @id @default(cuid())
  date      String   // ISO date "yyyy-MM-dd"
  car       Car      @relation(fields: [carId], references: [id])
  carId     String
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@unique([date, carId])
  @@index([date])
  @@index([updatedAt])
}

model Booking {
  id            String          @id @default(cuid())
  parent        DateCarBooking  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId      String
  startTime     Int             // minuter från midnatt
  endTime       Int             // minuter från midnatt
  distance      Int             @default(0)
  destination   Destination?    @relation(fields: [destinationId], references: [id])
  destinationId String?
  comment       String?
  recurrenceId  String?
  logged        String?         // Trip.id om loggad
  byUser        User            @relation("BookingByUser", fields: [byUserId], references: [id])
  byUserId      String

  users BookingUser[]
}

model BookingUser {
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  user      User    @relation(fields: [userId], references: [id])
  userId    String

  @@id([bookingId, userId])
}

model Trip {
  id        String     @id @default(cuid())
  car       Car        @relation(fields: [carId], references: [id])
  carId     String
  odo       Int
  distance  Int
  cost      Float
  comment   String?
  timestamp DateTime   @default(now())
  byUser    User       @relation("TripByUser", fields: [byUserId], references: [id])
  byUserId  String

  users TripUser[]
}

model TripUser {
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId String
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@id([tripId, userId])
}

// ---- Fellogg ----

model ErrorLog {
  id           String         @id @default(cuid())
  car          Car            @relation(fields: [carId], references: [id])
  carId        String
  description  String
  status       ErrorLogStatus @default(OPEN)
  assignedTo   User?          @relation("ErrorLogAssignee", fields: [assignedToId], references: [id])
  assignedToId String?
  updatedBy    User           @relation("ErrorLogUpdater", fields: [updatedById], references: [id])
  updatedById  String
  updatedAt    DateTime       @updatedAt
  createdAt    DateTime       @default(now())

  comments ErrorLogComment[]
}

model ErrorLogComment {
  id         String   @id @default(cuid())
  errorLog   ErrorLog @relation(fields: [errorLogId], references: [id], onDelete: Cascade)
  errorLogId String
  text       String
  byUser     User     @relation("ErrorLogCommentAuthor", fields: [byUserId], references: [id])
  byUserId   String
  createdAt  DateTime @default(now())
}

enum ErrorLogStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ---- Utlägg ----

model Expense {
  id          String        @id @default(cuid())
  car         Car           @relation(fields: [carId], references: [id])
  carId       String
  amount      Float
  description String
  status      ExpenseStatus @default(UNPAID)
  receiptData Bytes?        // JPEG/PNG som binary blob
  receiptMime String?       // t.ex. "image/jpeg"
  byUser      User          @relation("ExpenseByUser", fields: [byUserId], references: [id])
  byUserId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum ExpenseStatus {
  UNPAID
  PAID
}

// ---- Bilinfo ----

model CarInfo {
  id               String   @id @default(cuid())
  car              Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId            String   @unique
  inspectionDue    String?  // ISO date "yyyy-MM-dd", nästa besiktning
  lastService      String?  // ISO date "yyyy-MM-dd", senaste service
  owner            String?  // Fritext, ägarens namn/organisation
  insuranceCompany String?  // Fritext, försäkringsbolag
  updatedAt        DateTime @updatedAt
}

