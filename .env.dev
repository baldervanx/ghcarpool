# ============================================================
# Färdig konfiguration för lokal utveckling.
# Kopieras till packages/backend/.env:
#   cp .env.dev packages/backend/.env
#
# Kräver en lokal PostgreSQL på port 5432 med:
#   POSTGRES_USER=ghcarpool, POSTGRES_PASSWORD=dev, POSTGRES_DB=ghcarpool_dev
#
# Starta snabbt via Docker:
#   docker run -d --name ghcarpool-pg \
#     -e POSTGRES_USER=ghcarpool -e POSTGRES_PASSWORD=dev \
#     -e POSTGRES_DB=ghcarpool_dev -p 5432:5432 postgres:17-alpine
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL="postgresql://ghcarpool:***@127.0.0.1:5432/ghcarpool_dev"

# ── Express session ──────────────────────────────────────────
# Godtagbar för lokal dev — byt ut i produktion (openssl rand -hex 32)
SESSION_SECRET=dev-secret-byt-ut-i-produktion-32-tecken

# ── Google OAuth (optionellt) ─────────────────────────────────
# Lämna kommenterat för att köra utan Google-inloggning
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=*** # GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ── App ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PORT=3001
NODE_ENV=development
